# Copy this file to .env (in this same top-level folder) and fill in your key to enable the AI chatbot.
# Without a key, the chat widget still works using a simple keyword search.

# Your Anthropic API key (https://console.anthropic.com/).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which Claude model the agent uses (PydanticAI model string).
# Default is anthropic:claude-opus-5. A cheaper option: anthropic:claude-sonnet-5
# CAMPUS_CUSTOMS_MODEL=anthropic:claude-opus-5
